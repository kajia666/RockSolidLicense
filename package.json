{
  "name": "rock-solid-license",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "pg": "^8.13.1"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:postgres:init": "node scripts/render-postgres-init.mjs",
    "db:postgres:check": "node scripts/render-postgres-init.mjs --check",
    "deploy:windows:server-gate": "node scripts/windows-server-deploy-gate.mjs",
    "deploy:windows:prepare-local": "node scripts/windows-deploy-prepare-local.mjs",
    "deploy:windows:status": "node scripts/windows-deploy-status.mjs",
    "deploy:windows:operator-pack": "node scripts/windows-deploy-operator-pack.mjs",
    "deploy:windows:evidence-pack": "node scripts/windows-deploy-evidence-pack.mjs",
    "deploy:windows:prepare-pack": "node scripts/windows-first-deploy-pack.mjs",
    "deploy:windows:preflight": "node scripts/windows-deploy-preflight.mjs",
    "staging:preflight": "node scripts/staging-preflight.mjs",
    "recovery:preflight": "node scripts/recovery-preflight.mjs",
    "staging:rehearsal": "node scripts/staging-rehearsal.mjs",
    "staging:profile:init": "node scripts/staging-profile-init.mjs",
    "staging:profile:check": "node scripts/staging-profile-check.mjs",
    "staging:closeout:init": "node scripts/staging-closeout-init.mjs",
    "staging:closeout:backfill": "node scripts/staging-closeout-backfill.mjs",
    "staging:signoff:backfill": "node scripts/staging-signoff-backfill.mjs",
    "staging:launch-duty:record": "node scripts/staging-launch-duty-record.mjs",
    "staging:readiness:status": "node scripts/staging-readiness-status.mjs",
    "launch:production-proof-preflight": "node scripts/production-proof-preflight.mjs",
    "launch:smoke": "node scripts/launch-smoke.mjs",
    "launch:smoke:staging": "node scripts/launch-smoke.mjs --require-https",
    "launch:route-map-gate": "node scripts/launch-route-map-gate.mjs",
    "test": "node --test --test-concurrency=1 --test-isolation=none"
  }
}
